# 仓库内统一以 LF 存储，检出行为交给各平台
* text=auto eol=lf

# Windows 脚本保持 CRLF，避免 cmd / PowerShell 5.1 解析异常
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 渲染回归样本按字节保存：crlf.md 必须真的含 CRLF，gbk.md 是 GBK 编码，
# 行尾归一化会破坏测试前提（tests/render_regression.rs）
fixtures/cases/crlf.md -text
fixtures/cases/gbk.md -text

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.ttf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.msi binary
*.exe binary

# 锁文件不参与语言统计与 diff 展示
package-lock.json linguist-generated=true
Cargo.lock linguist-generated=true
